  <ControlTemplate x:Key="MenuItemButton" TargetType="{x:Type MenuItem}">
    <Grid Name="templateRoot" SnapsToDevicePixels="True">
      <Grid Name="ButtonGridActive" Background="{DynamicResource ActiveColor}" Opacity="0" />
      <Grid Name="ButtonGridOver" Background="{DynamicResource HoverColor}" Opacity="0" />
      <Grid Height="24" Width="24" HorizontalAlignment="Right">
        <Path Data="{DynamicResource ic_down_base}" Fill="{DynamicResource IconBase}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
      <Popup Name="PART_Popup" AllowsTransparency="True" Focusable="False" PopupAnimation="None" Placement="Bottom" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
        <Border Name="Border" Background="{DynamicResource ColorD}" BorderThickness="1" BorderBrush="{DynamicResource ColorBG}">
          <StackPanel IsItemsHost="True" MinWidth="140" Margin="4" KeyboardNavigation.DirectionalNavigation="Cycle" />
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="MenuItem.IsHighlighted" Value="True"><Setter TargetName="ButtonGridOver" Property="UIElement.Opacity" Value="1" /></Trigger>
      <Trigger Property="MenuItem.IsSubmenuOpen" Value="True"><Setter TargetName="ButtonGridActive" Property="UIElement.Opacity" Value="1" /></Trigger>
      <Trigger Property="UIElement.IsEnabled" Value="False"><Setter TargetName="templateRoot" Property="UIElement.Opacity" Value="0.3" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
