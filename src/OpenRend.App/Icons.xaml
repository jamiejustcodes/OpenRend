      <Grid Name="ButtonGridOver" Background="{DynamicResource HoverColor}" Opacity="0" />
      <Path Name="IconBase" Data="{DynamicResource ic_refresh_base}" Fill="{DynamicResource IconBase}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True"><Setter TargetName="ButtonGridOver" Property="UIElement.Opacity" Value="1" /></Trigger>
      <Trigger Property="ButtonBase.IsPressed" Value="True"><Setter TargetName="ButtonGridDown" Property="UIElement.Opacity" Value="1" /></Trigger>
      <Trigger Property="UIElement.IsEnabled" Value="False"><Setter TargetName="ButtonGrid" Property="UIElement.Opacity" Value="0.3" /></Trigger>
