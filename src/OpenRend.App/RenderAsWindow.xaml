<Window x:Class="OpenRend.App.RenderAsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Render As" Width="880" Height="600" MinWidth="740" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ColorBG}"
        Foreground="{StaticResource TextColor}"
        TextElement.FontFamily="Segoe UI"
        TextElement.FontSize="11">
  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    
    <!-- Header / Search Toolbar matching Vegas Pro Render As -->
    <Border Grid.Row="0" Background="{StaticResource ColorD}" Padding="8,6" Margin="0,0,0,10" BorderBrush="{StaticResource ColorM}" BorderThickness="1">
      <DockPanel LastChildFill="True">
        <CheckBox x:Name="FavoritesOnly" AutomationProperties.AutomationId="RenderFavoritesOnly" Content="Show favorites only" DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextColor}" Checked="FilterChanged" Unchecked="FilterChanged"/>
        <CheckBox x:Name="MatchProject" AutomationProperties.AutomationId="RenderMatchProject" Content="Match project settings" DockPanel.Dock="Right" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextColor}" Checked="FilterChanged" Unchecked="FilterChanged"/>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0">
          <ContentControl Width="20" Height="20" ContentTemplate="{StaticResource ic_search}" Style="{StaticResource BaseContentControl}" Margin="0,0,6,0"/>
          <Label Content="_Search:" Target="Search" Foreground="{StaticResource TextColor}" Padding="0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBox x:Name="Search" AutomationProperties.AutomationId="RenderSearch" AutomationProperties.Name="Search render templates" Background="{StaticResource ColorBG}" Foreground="{StaticResource TextColor}" BorderBrush="{StaticResource ColorM}" Padding="6,3" VerticalContentAlignment="Center" TextChanged="SearchChanged"/>
      </DockPanel>
    </Border>

    <!-- Main Content: Formats (left) and Templates (right) -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      
      <!-- Formats Column -->
      <DockPanel Grid.Column="0">
        <Border DockPanel.Dock="Top" Background="{StaticResource ColorD}" Padding="8,5" BorderBrush="{StaticResource ColorM}" BorderThickness="1,1,1,0">
          <TextBlock Text="Formats" FontWeight="SemiBold" Foreground="{StaticResource TextColor}"/>
        </Border>
        <ListBox x:Name="Formats" AutomationProperties.AutomationId="RenderFormats" AutomationProperties.Name="Formats" DisplayMemberPath="Name" SelectionChanged="FormatChanged" Background="{StaticResource ColorD}" Foreground="{StaticResource TextColor}" BorderBrush="{StaticResource ColorM}" BorderThickness="1"/>
      </DockPanel>

      <!-- Center Splitter -->
      <GridSplitter Grid.Column="1" Width="6" Style="{StaticResource TabGridSplitterStyle}"/>

      <!-- Templates Column -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" Background="{StaticResource ColorD}" Padding="8,5" BorderBrush="{StaticResource ColorM}" BorderThickness="1,1,1,0">
          <TextBlock Text="Templates" FontWeight="SemiBold" Foreground="{StaticResource TextColor}"/>
        </Border>
        
        <!-- Bottom Template Inspector/Actions -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ColorD}" Padding="10,8" Margin="0,8,0,0" BorderBrush="{StaticResource ColorM}" BorderThickness="1">
          <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,6">
              <Button x:Name="Customize" Style="{StaticResource TextButton}" Content="Customize Template…" AutomationProperties.AutomationId="CustomizeRenderTemplate" Click="CustomizeClick" ToolTip="Change the name, quality, audio bitrate or encoder speed." Margin="0,0,8,0"/>
              <Button x:Name="DeleteTemplate" Style="{StaticResource TextButton}" Content="Delete Template" AutomationProperties.AutomationId="DeleteRenderTemplate" Click="DeleteTemplateClick"/>
              <CheckBox x:Name="Favorite" DockPanel.Dock="Right" Content="Favorite" AutomationProperties.AutomationId="RenderFavorite" Foreground="{StaticResource TextColor}" VerticalAlignment="Center" Checked="FavoriteChanged" Unchecked="FavoriteChanged"/>
            </DockPanel>
            <TextBlock x:Name="Details" TextWrapping="Wrap" Foreground="{StaticResource TextColorGrey}" MinHeight="28" LineHeight="14"/>
          </StackPanel>
        </Border>

        <ListBox x:Name="Templates" AutomationProperties.AutomationId="RenderTemplates" AutomationProperties.Name="Templates" DisplayMemberPath="Name" SelectionChanged="TemplateChanged" Background="{StaticResource ColorD}" Foreground="{StaticResource TextColor}" BorderBrush="{StaticResource ColorM}" BorderThickness="1"/>
      </DockPanel>
    </Grid>

    <!-- Destination / Output Folder & File Name -->
    <Border Grid.Row="2" Background="{StaticResource ColorD}" Padding="10,8" Margin="0,10,0,0" BorderBrush="{StaticResource ColorM}" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="65"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="6"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Label Content="_Folder:" Target="Folder" Foreground="{StaticResource TextColor}" VerticalAlignment="Center"/>
        <TextBox Grid.Column="1" x:Name="Folder" AutomationProperties.AutomationId="RenderFolder" AutomationProperties.Name="Output folder" Background="{StaticResource ColorBG}" Foreground="{StaticResource TextColor}" BorderBrush="{StaticResource ColorM}" Padding="6,3" VerticalContentAlignment="Center" TextChanged="TargetChanged"/>
        <Button Grid.Column="2" Style="{StaticResource TextButton}" Content="Browse…" Click="BrowseClick" Margin="6,0,0,0"/>
        
        <Label Grid.Row="2" Content="_Name:" Target="FileName" Foreground="{StaticResource TextColor}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="FileName" AutomationProperties.AutomationId="RenderFileName" AutomationProperties.Name="Output file name" Background="{StaticResource ColorBG}" Foreground="{StaticResource TextColor}" BorderBrush="{StaticResource ColorM}" Padding="6,3" VerticalContentAlignment="Center" TextChanged="TargetChanged"/>
      </Grid>
    </Border>

    <!-- Render Options GroupBox -->
    <GroupBox Grid.Row="3" Header="Render Options" Style="{StaticResource PreferencesGroup}" Margin="0,8,0,0">
      <Grid Margin="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <CheckBox x:Name="UseLoop" Content="Render loop region only" AutomationProperties.AutomationId="RenderLoopOnly" Foreground="{StaticResource TextColor}" Checked="OptionStateChanged" Unchecked="OptionStateChanged"/>
          <TextBlock x:Name="RangeDetails" Foreground="{StaticResource TextColorGrey}" Margin="20,4,0,4"/>
          <CheckBox x:Name="StretchToFill" Content="Stretch video to fill output frame size (do not letterbox)" AutomationProperties.AutomationId="RenderStretchToFill" Foreground="{StaticResource TextColor}" Margin="0,4,0,0"/>
          <CheckBox x:Name="GenerateLoudnessLog" Content="Generate loudness log (.loudness.log)" AutomationProperties.AutomationId="RenderLoudnessLog" Foreground="{StaticResource TextColor}" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
          <DockPanel Margin="0,0,0,6">
            <Label Content="Channel mapping:" Target="ChannelMappingCombo" Foreground="{StaticResource TextColor}" VerticalAlignment="Center" Padding="0,0,8,0"/>
            <ComboBox x:Name="ChannelMappingCombo" AutomationProperties.AutomationId="RenderChannelMapping"/>
          </DockPanel>
          <TextBlock x:Name="EstimatedFileSize" Text="Estimated file size: ~0 MB" Foreground="{StaticResource TextColor}" Margin="0,4,0,2"/>
          <TextBlock x:Name="DiskSpace" Text="Disk space available: calculating…" Foreground="{StaticResource TextColorGrey}" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>
    </GroupBox>

    <!-- Error Message -->
    <TextBlock Grid.Row="4" x:Name="Error" Foreground="#FF7B5F" TextWrapping="Wrap" Margin="0,6,0,4"/>

    <!-- Bottom Actions -->
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
      <Button Style="{StaticResource TextButton}" Background="{StaticResource ActiveColor}" Content="Render" MinWidth="90" Height="26" FontWeight="SemiBold" IsDefault="True" AutomationProperties.AutomationId="StartRender" Click="RenderClick" Margin="0,0,8,0"/>
      <Button Style="{StaticResource TextButton}" Content="Cancel" MinWidth="90" Height="26" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
