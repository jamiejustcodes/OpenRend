<Window x:Class="OpenRend.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenRend.App" xmlns:ui="clr-namespace:OpenRend.UI;assembly=OpenRend.UI" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="{Binding Title}" Width="1400" Height="900" MinWidth="960" MinHeight="620" WindowStyle="None" WindowState="Maximized" WindowStartupLocation="CenterScreen" AllowDrop="True" PreviewKeyDown="WindowKeyDown" Drop="WindowDrop" Closing="WindowClosing">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Icon><BitmapImage UriSource="OpenRend.ico"/></Window.Icon>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="34"/><RowDefinition x:Name="WorkspaceHeight" Height="600" MinHeight="230"/><RowDefinition Height="1"/><RowDefinition Height="*" MinHeight="140"/><RowDefinition Height="34"/><RowDefinition Height="20"/></Grid.RowDefinitions>
    <Grid Background="#141414">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource CaptionButton}" AutomationProperties.Name="Minimise" Click="MinimizeClick"><Image Source="{StaticResource Icon.Minimize}" Width="12" Height="12"/></Button><Button Style="{StaticResource CaptionButton}" AutomationProperties.Name="Maximise" Click="MaximizeClick"><Image Source="{StaticResource Icon.Restore}" Width="12" Height="12"/></Button><Button Style="{StaticResource CaptionCloseButton}" AutomationProperties.Name="Close" Click="ExitClick"><Image Source="{StaticResource Icon.Close}" Width="12" Height="12"/></Button></StackPanel>
        <Image Source="OpenRend.ico" Width="21" Height="21" Margin="4,0,7,0"/>
    <Menu shell:WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Stretch">
      <MenuItem Header="_File">
        <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="NewClick"/>
        <MenuItem Header="_Open project…" InputGestureText="Ctrl+O" Click="OpenClick"/>
        <MenuItem Header="Import legacy project…" Click="ImportLegacyClick"/>
        <Separator/>
        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveClick"/>
        <MenuItem Header="Save _as…" InputGestureText="Ctrl+Shift+S" Click="SaveAsClick"/>
        <MenuItem Header="Open recovery project…" Click="RecoveryClick"/>
        <Separator/>
        <MenuItem Header="_Import media…" InputGestureText="Ctrl+I" Click="ImportClick"/>
        <MenuItem Header="Relink missing media…" Click="RelinkClick"/>
        <MenuItem Header="Project settings…" InputGestureText="Alt+Enter" Click="SettingsClick"/>
        <Separator/>
        <MenuItem Header="_Render as…" InputGestureText="Ctrl+Shift+E" Click="ExportClick"/>
        <Separator/><MenuItem Header="E_xit" Click="ExitClick"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="UndoMenu" Header="_Undo" InputGestureText="Ctrl+Z" Click="UndoClick"/>
        <MenuItem x:Name="RedoMenu" Header="_Redo" InputGestureText="Ctrl+Y" Click="RedoClick"/>
        <Separator/>
        <MenuItem Header="Cut" InputGestureText="Ctrl+X" Click="CutClick"/>
        <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="CopyClick"/>
        <MenuItem Header="Paste" InputGestureText="Ctrl+V" Click="PasteClick"/>
        <Separator/>
        <MenuItem Header="Split at cursor" InputGestureText="S" Click="SplitClick"/>
        <MenuItem Header="Delete selection" InputGestureText="Delete" Click="DeleteClick"/>
        <MenuItem Header="Select all clips" InputGestureText="Ctrl+A" Click="SelectAllClick"/>
        <Separator/>
        <MenuItem Header="Link selected clips" InputGestureText="G" Click="LinkClick"/>
        <MenuItem Header="Unlink clip group" InputGestureText="U" Click="UnlinkClick"/>
        <MenuItem x:Name="IgnoreGroupsMenu" Header="Ignore clip groups" IsCheckable="True" Click="IgnoreGroupsClick"/>
        <Separator/>
        <MenuItem Header="Switches">
          <MenuItem Header="Normalize audio" InputGestureText="Ctrl+Shift+N" Click="NormalizeAudioClipClick"/>
          <MenuItem Header="Mute audio" InputGestureText="Ctrl+Shift+M" Click="MuteAudioClipClick"/>
          <MenuItem Header="Invert phase" Click="InvertPhaseClipClick"/>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Fit timeline" InputGestureText="Ctrl+F" Click="FitClick"/>
        <MenuItem Header="Zoom in" InputGestureText="+" Click="ZoomInClick"/>
        <MenuItem Header="Zoom out" InputGestureText="−" Click="ZoomOutClick"/>
        <MenuItem Header="Reset workspace" Click="ResetWorkspaceClick"/>
      </MenuItem>
      <MenuItem Header="_Insert">
        <MenuItem Header="Text media…" InputGestureText="Ctrl+Shift+T" Click="InsertTextMediaClick"/>
        <MenuItem Header="Solid color…" Click="InsertSolidColorClick"/>
        <MenuItem Header="Video track" InputGestureText="Ctrl+Shift+V" Click="VideoTrackClick"/>
        <MenuItem Header="Audio track" InputGestureText="Ctrl+Shift+A" Click="AudioTrackClick"/>
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem x:Name="PanCropMenu" Header="Video event Pan/Crop…" Click="PanCropClick"/>
        <MenuItem x:Name="VideoEffectsMenu" Header="Video event FX…" Click="VideoEffectsClick"/>
        <MenuItem Header="Clip properties" Click="ClipPropertiesClick"/>
        <Separator/>
        <MenuItem Header="Scene Detection…" Click="SceneDetectionClick"/>
        <Separator/>
        <MenuItem x:Name="AiTextToSpeechMenu" Header="AI Text to S_peech" InputGestureText="Ctrl+Shift+P" Click="AiTextToSpeechClick"/>
        <MenuItem x:Name="AiSpeechToTextMenu" Header="AI Speech to Tex_t" Click="AiSpeechToTextClick"/>
        <MenuItem x:Name="AiAutoReframeMenu" Header="AI Auto _Reframe" Click="AiAutoReframeClick"/>
        <Separator/>
        <MenuItem Header="Render as…" Click="ExportClick"/>
      </MenuItem>
      <MenuItem Header="_Options"><MenuItem x:Name="SnappingMenu" Header="Enable snapping" InputGestureText="N" IsCheckable="True" IsChecked="True" Click="SnapMenuClick"/><MenuItem x:Name="RippleMenu" Header="Ripple editing" IsCheckable="True" Click="RippleMenuClick"/></MenuItem>
      <MenuItem Header="_Help"><MenuItem Header="Keyboard shortcuts" Click="ShortcutsClick"/><MenuItem Header="About OpenRend" Click="AboutClick"/></MenuItem>
    </Menu>
      </DockPanel>
      <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" IsHitTestVisible="False"/>
    </Grid>
    <Border Grid.Row="1" Background="#262626" Padding="3,1" BorderBrush="#111111" BorderThickness="0,0,0,2">
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="New project" ToolTip="New project (Ctrl+N)" Click="NewClick"><Image Source="{StaticResource Icon.New}"/></Button>
        <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Open" ToolTip="Open project (Ctrl+O)" Click="OpenClick"><Image Source="{StaticResource Icon.Open}"/></Button>
        <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Save" ToolTip="Save project (Ctrl+S)" Click="SaveClick"><Image Source="{StaticResource Icon.Save}"/></Button>
        <Button x:Name="RenderButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Render as…" ToolTip="Render as (Ctrl+Shift+E)" Click="ExportClick"><Image Source="{StaticResource Icon.Render}"/></Button>
        <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Project settings" ToolTip="Project settings (Alt+Enter)" Click="SettingsClick"><Image Source="{StaticResource Icon.Settings}"/></Button>
        <Button x:Name="CutButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Cut" ToolTip="Cut (Ctrl+X)" Click="CutClick"><Image Source="{StaticResource Icon.Cut}"/></Button>
        <Button x:Name="CopyButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Copy" ToolTip="Copy (Ctrl+C)" Click="CopyClick"><Image Source="{StaticResource Icon.Copy}"/></Button>
        <Button x:Name="PasteButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Paste" ToolTip="Paste (Ctrl+V)" Click="PasteClick"><Image Source="{StaticResource Icon.Paste}"/></Button>
        <Button x:Name="UndoButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Undo" ToolTip="Undo (Ctrl+Z)" Click="UndoClick"><Image Source="{StaticResource Icon.Undo}"/></Button>
        <Button x:Name="RedoButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Redo" ToolTip="Redo (Ctrl+Y)" Click="RedoClick"><Image Source="{StaticResource Icon.Redo}"/></Button>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2" x:Name="Workspace" Margin="4,0">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="MediaWidth" Width="*" MinWidth="280"/><ColumnDefinition Width="5"/><ColumnDefinition x:Name="PreviewWidth" Width="844" MinWidth="320"/><ColumnDefinition Width="5"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
      <TabControl x:Name="ToolsTabs" TabStripPlacement="Bottom" SelectedIndex="1">
        <TabItem Header="Explorer"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="32"><Button Content="Choose folder…" Click="BrowseFolderClick"/><TextBlock x:Name="FolderLabel" Text="Choose a folder to browse media" TextTrimming="CharacterEllipsis" MaxWidth="300" Margin="6,0"/></StackPanel><ListBox x:Name="ExplorerList" DisplayMemberPath="Name" MouseDoubleClick="ExplorerDoubleClick"/></DockPanel></TabItem>
        <TabItem Header="Project Media">
          <DockPanel>
            <Border DockPanel.Dock="Top" Height="32" BorderBrush="#111111" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Remove unused media" ToolTip="Remove unused media from project" Click="RemoveUnusedClick"><Image Source="{StaticResource Icon.Delete}"/></Button><Button Style="{StaticResource ToolbarButton}" Width="126" AutomationProperties.Name="Import Media…" Click="ImportClick"><StackPanel Orientation="Horizontal"><Image Source="{StaticResource Icon.Import}" Width="16" Height="16"/><TextBlock Text="Import Media…" Margin="5,0"/></StackPanel></Button><Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Add to timeline" Click="PlaceSelectedClick" ToolTip="Insert selected media at cursor"><Image Source="{StaticResource Icon.Play}"/></Button></StackPanel></Border>
            <Border DockPanel.Dock="Bottom" Height="28" BorderBrush="#303030" BorderThickness="0,1,0,0"><TextBlock x:Name="MediaDetails" FontSize="11" TextTrimming="CharacterEllipsis" Margin="174,0,4,0"/></Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="166"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <DockPanel Background="#262626"><TextBlock x:Name="MediaCount" DockPanel.Dock="Bottom" Foreground="#B8B8B8" Margin="8,4" FontSize="10"/><TreeView x:Name="MediaTree" Background="#262626" Foreground="#DDDDDD" BorderThickness="0" FontSize="11" SelectedItemChanged="MediaFilterChanged" Padding="3,2"><TreeViewItem Header="All Media" Tag="All" IsSelected="True" IsExpanded="True"><TreeViewItem Header="Video" Tag="Video"/><TreeViewItem Header="Audio" Tag="Audio"/><TreeViewItem Header="Missing Media" Tag="Missing"/></TreeViewItem></TreeView></DockPanel>
              <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
              <Grid Grid.Column="2">
                <ListBox x:Name="MediaList" ItemsSource="{Binding Library}" MouseDoubleClick="MediaDoubleClick" PreviewMouseMove="MediaMouseMove" SelectionChanged="MediaSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Width" Value="128"/><Setter Property="Height" Value="104"/><Setter Property="Padding" Value="5"/><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="VerticalContentAlignment" Value="Top"/></Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate><DataTemplate><StackPanel><Border Background="#181818" Width="116" Height="66"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border><TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Height="28" Margin="0,2,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyLibrary" Text="Import video or audio&#10;Ctrl+I or drop files here" TextAlignment="Center" Foreground="#B8B8B8" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
            </Grid>
          </DockPanel>
        </TabItem>
        <TabItem Header="Transitions">
          <Grid Background="#262626">
            <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TabControl Grid.Row="0" Background="#262626" BorderThickness="0" AutomationProperties.Name="Transition categories">
              <TabItem Header="All Plug-ins" IsSelected="True"/>
              <TabItem Header="Fades"/>
            </TabControl>
            <TextBox x:Name="TransitionSearch" Grid.Row="1" Margin="5,3" Padding="5,1" VerticalContentAlignment="Center" TextChanged="TransitionSearchChanged" AutomationProperties.Name="Search transitions"/>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <ListBox x:Name="TransitionPlugIns" Background="#303030" Foreground="#E6E6E6" BorderThickness="0" FontSize="12" AutomationProperties.Name="Transition plug-ins"><ListBoxItem x:Name="DissolvePluginItem" Content="Dissolve" IsSelected="True"/></ListBox>
              <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
              <ListBox x:Name="TransitionPresets" Grid.Column="2" Padding="7" BorderThickness="0" Background="#262626" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="TransitionPresetKeyDown" PreviewMouseMove="TransitionPresetMouseMove" AutomationProperties.Name="Transition presets">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBoxItem x:Name="DefaultDissolvePreset" Width="124" Height="103" Padding="4" Margin="2" IsSelected="True" MouseDoubleClick="TransitionPresetDoubleClick" PreviewMouseLeftButtonDown="TransitionPresetMouseDown" PreviewMouseRightButtonDown="TransitionPresetMouseDown" AutomationProperties.Name="Default" ToolTip="Double-click to add to the selection, or drag to a video overlap.">
                  <Grid><StackPanel><Border Width="110" Height="69" BorderBrush="#777777" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#316E9C" Offset="0"/><GradientStop Color="#A8A8A8" Offset="0.5"/><GradientStop Color="#B97344" Offset="1"/></LinearGradientBrush></Border.Background></Border><TextBlock Text="Default" TextAlignment="Center" Margin="0,4,0,0" Foreground="#E6E6E6" FontSize="11"/></StackPanel>
                    <Button x:Name="AddDefaultDissolve" Content="+" Width="21" Height="21" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ApplyDefaultDissolveClick" AutomationProperties.Name="Add Default Dissolve" ToolTip="Add to selected events"/>
                  </Grid>
                </ListBoxItem>
              </ListBox>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="Clip Properties">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
            <TextBlock x:Name="ClipName" Text="Select a timeline clip" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Grid x:Name="Inspector" IsEnabled="False"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Text="Position (frames)"/><TextBox x:Name="ClipStart" Grid.Column="1"/>
              <TextBlock Grid.Row="1" Text="Source in (frames)"/><TextBox x:Name="ClipIn" Grid.Row="1" Grid.Column="1"/>
              <TextBlock Grid.Row="2" Text="Duration (frames)"/><TextBox x:Name="ClipDuration" Grid.Row="2" Grid.Column="1"/>
              <TextBlock Grid.Row="3" Text="Opacity (0–1)"/><TextBox x:Name="ClipOpacity" Grid.Row="3" Grid.Column="1"/>
              <TextBlock Grid.Row="4" Text="Audio gain"/><TextBox x:Name="ClipGain" Grid.Row="4" Grid.Column="1"/>
              <TextBlock Grid.Row="5" Text="Pan (−1 to 1)"/><TextBox x:Name="ClipPan" Grid.Row="5" Grid.Column="1"/>
              <TextBlock Grid.Row="6" Text="Fade in (frames)"/><TextBox x:Name="ClipFadeIn" Grid.Row="6" Grid.Column="1"/>
              <TextBlock Grid.Row="7" Text="Fade out (frames)"/><TextBox x:Name="ClipFadeOut" Grid.Row="7" Grid.Column="1"/>
              <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal"><Button Content="Apply clip properties" Click="ApplyPropertiesClick" Margin="2,10"/><Button Content="Normalize (0 dB)" Click="NormalizeAudioClipClick" ToolTip="Normalize audio peak to 0 dB" Margin="4,10"/><Button Content="Mute" Click="MuteAudioClipClick" ToolTip="Toggle clip audio mute" Margin="4,10"/><Button x:Name="EditTextMediaButton" Content="Edit text…" Click="EditTextMediaClick" ToolTip="Edit Titles &amp; Text media properties" Margin="4,10" Visibility="Collapsed"/></StackPanel>
            </Grid>
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
      <TabControl Grid.Column="2" TabStripPlacement="Bottom"><TabItem Header="Video Preview">
        <Grid Background="#262626"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="32"/><RowDefinition Height="28"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Project video settings" Click="SettingsClick" ToolTip="Project video properties"><Image Source="{StaticResource Icon.Settings}"/></Button>
            <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Copy preview snapshot" Click="CopySnapshotClick" ToolTip="Copy snapshot"><Image Source="{StaticResource Icon.Copy}"/></Button>
            <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Save preview snapshot" Click="SaveSnapshotClick" ToolTip="Save snapshot"><Image Source="{StaticResource Icon.Camera}"/></Button>
            <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Toggle safe areas" Click="GuidesClick" ToolTip="Safe area guides"><Image Source="{StaticResource Icon.Grid}"/></Button>
            <ComboBox x:Name="PreviewQuality" Width="128" SelectionChanged="QualityChanged" SelectedIndex="1"><ComboBoxItem Content="Draft (Auto)"/><ComboBoxItem Content="Preview (Auto)"/><ComboBoxItem Content="Best (Full)"/></ComboBox>
            <ComboBox x:Name="PreviewZoom" Width="80" Margin="6,0" SelectionChanged="QualityChanged" SelectedIndex="0"><ComboBoxItem Content="100 %"/><ComboBoxItem Content="200 %"/><ComboBoxItem Content="50 %"/></ComboBox>
          </StackPanel>
          <Border Grid.Row="1" Background="Black" Margin="0,4,0,0"><local:PreviewHost x:Name="Preview"/></Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"><Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Go to start" ToolTip="Go to start (Ctrl+Home)" Click="StartClick"><Image Source="{StaticResource Icon.First}"/></Button><Button x:Name="PlayButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Play" ToolTip="Play / pause (Space)" Click="PlayClick"><Image Source="{StaticResource Icon.Play}"/></Button><Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Pause" ToolTip="Pause (Enter)" Click="PauseClick"><Image Source="{StaticResource Icon.Pause}"/></Button><Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Stop" ToolTip="Stop (Esc)" Click="StopClick"><Image Source="{StaticResource Icon.Stop}"/></Button></StackPanel>
          <TextBlock Grid.Row="3" x:Name="PreviewInfo" Margin="9,4" Foreground="#B8B8B8" FontSize="11"/>
        </Grid>
      </TabItem></TabControl>
      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>
      <TabControl Grid.Column="4" TabStripPlacement="Bottom"><TabItem Header="Master Bus"><Grid Background="#262626"><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="24"/><RowDefinition Height="28"/><RowDefinition Height="*"/><RowDefinition Height="14"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Reset monitor gain" ToolTip="Reset monitor gain to 0 dB" Click="ResetMasterClick"><Image Source="{StaticResource Icon.Settings}"/></Button><Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Mute monitor" ToolTip="Mute monitor" Click="MuteMasterClick"><Image Source="{StaticResource Icon.Pause}"/></Button></StackPanel>
        <TextBlock Grid.Row="1" Text="Master" Margin="8,0" FontSize="11"/>
        <TextBlock x:Name="MasterLevel" Grid.Row="2" Text="0.0 dB" FontSize="11" Margin="8,0"/>
        <Grid x:Name="MeterArea" Grid.Row="3" Margin="8,5,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="9"/><ColumnDefinition Width="24"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Slider x:Name="MasterGain" Orientation="Vertical" Minimum="0" Maximum="2" Value="1" Margin="0,0,12,0" ToolTip="Monitor gain" ValueChanged="MasterGainChanged"/>
          <Border Grid.Column="1" Background="#181818"><Grid><Border x:Name="LeftMeter" VerticalAlignment="Bottom" Height="0"><Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#4D9761" Offset="0"/><GradientStop Color="#B9BE58" Offset="0.85"/><GradientStop Color="#BD6959" Offset="1"/></LinearGradientBrush></Border.Background></Border></Grid></Border>
          <UniformGrid Grid.Column="2" Rows="11"><UniformGrid.Resources><Style TargetType="TextBlock"><Setter Property="FontSize" Value="8"/><Setter Property="Foreground" Value="#888888"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style></UniformGrid.Resources><TextBlock Text="0"/><TextBlock Text="−6"/><TextBlock Text="−12"/><TextBlock Text="−18"/><TextBlock Text="−24"/><TextBlock Text="−30"/><TextBlock Text="−36"/><TextBlock Text="−42"/><TextBlock Text="−48"/><TextBlock Text="−54"/><TextBlock Text="−60"/></UniformGrid>
          <Border Grid.Column="3" Background="#181818"><Grid><Border x:Name="RightMeter" VerticalAlignment="Bottom" Height="0" Background="{Binding Background, ElementName=LeftMeter}"/></Grid></Border>
        </Grid>
        <TextBlock Grid.Row="4" Text="L        R" TextAlignment="Center" FontSize="9" Foreground="#999999"/>
      </Grid></TabItem></TabControl>
    </Grid>
    <GridSplitter Grid.Row="3" Height="1" HorizontalAlignment="Stretch"/>
    <Grid Grid.Row="4" Margin="4,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions>
      <ui:TimelineView x:Name="Timeline"/>
      <Grid Grid.Row="1" Background="#262626"><Grid.ColumnDefinitions><ColumnDefinition Width="256"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollBar x:Name="TimelineScroll" Grid.Column="1" Orientation="Horizontal" Minimum="0" ViewportSize="100" SmallChange="20" LargeChange="100" ValueChanged="TimelineScrollChanged" ToolTip="Timeline horizontal scroll"/></Grid>
    </Grid>
    <Border Grid.Row="5" Background="#262626" Padding="4,2" BorderBrush="#111111" BorderThickness="0,1,0,0"><DockPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBlock x:Name="Timecode" FontSize="11" FontFamily="Consolas" Width="105" Text="00:00:00:00"/><Button Style="{StaticResource ToolbarButton}" Content="−" Click="ZoomOutClick" ToolTip="Zoom out"/><Button Style="{StaticResource ToolbarButton}" Content="+" Click="ZoomInClick" ToolTip="Zoom in"/><Button Style="{StaticResource ToolbarButton}" Content="↔" Click="FitClick" ToolTip="Fit timeline"/></StackPanel>
      <StackPanel Orientation="Horizontal"><TextBlock x:Name="PlaybackRate" Text="Rate: 0.00" Width="252" FontSize="11"/>
        <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Play from start" Click="PlayFromStartClick" ToolTip="Play from start (Shift+Space)"><Image Source="{StaticResource Icon.First}"/></Button>
        <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Play" Click="PlayClick" ToolTip="Play / pause (Space)"><Image Source="{StaticResource Icon.Play}"/></Button>
        <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Pause" Click="PauseClick" ToolTip="Pause (Enter)"><Image Source="{StaticResource Icon.Pause}"/></Button>
        <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Stop" Click="StopClick" ToolTip="Stop (Esc)"><Image Source="{StaticResource Icon.Stop}"/></Button>
        <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Go to start" Click="StartClick" ToolTip="Go to start (Ctrl+Home)"><Image Source="{StaticResource Icon.First}"/></Button>
        <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Go to end" Click="EndClick" ToolTip="Go to end (Ctrl+End)"><Image Source="{StaticResource Icon.Last}"/></Button>
        <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Previous frame" Click="PreviousClick" ToolTip="Previous frame (Alt+Left)"><Image Source="{StaticResource Icon.StepPrevious}"/></Button>
        <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Next frame" Click="NextClick" ToolTip="Next frame (Alt+Right)"><Image Source="{StaticResource Icon.StepNext}"/></Button>
        <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Split" Click="SplitClick" ToolTip="Split (S)"><Image Source="{StaticResource Icon.Split}"/></Button>
        <Button Style="{StaticResource ToolbarButton}" AutomationProperties.Name="Delete" Click="DeleteClick" ToolTip="Delete"><Image Source="{StaticResource Icon.Delete}"/></Button>
        <CheckBox x:Name="SnapToggle" Content="Snap" IsChecked="True" Click="SnapClick"/><CheckBox x:Name="RippleToggle" Content="Ripple" Click="RippleClick"/>
      </StackPanel>
    </DockPanel></Border>
    <DockPanel Grid.Row="6" Margin="8,3"><ProgressBar DockPanel.Dock="Right" Width="160" Maximum="1" Value="{Binding Progress}"/><Button x:Name="CancelRender" DockPanel.Dock="Right" Content="Cancel render" Visibility="Collapsed" Click="CancelExportClick" Padding="7,1"/><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Foreground="#B8B8B8" FontSize="11"/></DockPanel>
  </Grid>
</Window>
