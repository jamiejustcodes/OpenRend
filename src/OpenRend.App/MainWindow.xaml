<Window x:Class="OpenRend.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenRend.App" xmlns:ui="clr-namespace:OpenRend.UI;assembly=OpenRend.UI" Title="{Binding Title}" Width="1400" Height="900" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen" AllowDrop="True" PreviewKeyDown="WindowKeyDown" Drop="WindowDrop" Closing="WindowClosing">
  <Window.Icon><BitmapImage UriSource="OpenRend.ico"/></Window.Icon>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="WorkspaceHeight" Height="7*" MinHeight="230"/><RowDefinition Height="5"/><RowDefinition Height="3*" MinHeight="140"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Menu>
      <MenuItem Header="_File">
        <MenuItem Header="_New" InputGestureText="Ctrl+N" Click="NewClick"/>
        <MenuItem Header="_Open project…" InputGestureText="Ctrl+O" Click="OpenClick"/>
        <MenuItem Header="Import legacy project…" Click="ImportLegacyClick"/>
        <Separator/>
        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveClick"/>
        <MenuItem Header="Save _as…" InputGestureText="Ctrl+Shift+S" Click="SaveAsClick"/>
        <MenuItem Header="Open recovery project…" Click="RecoveryClick"/>
        <Separator/>
        <MenuItem Header="_Import media…" InputGestureText="Ctrl+I" Click="ImportClick"/>
        <MenuItem Header="Relink missing media…" Click="RelinkClick"/>
        <MenuItem Header="Project settings…" InputGestureText="Alt+Enter" Click="SettingsClick"/>
        <Separator/>
        <MenuItem Header="_Render as…" InputGestureText="Ctrl+Shift+E" Click="ExportClick"/>
        <Separator/><MenuItem Header="E_xit" Click="ExitClick"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="UndoMenu" Header="_Undo" InputGestureText="Ctrl+Z" Click="UndoClick"/>
        <MenuItem x:Name="RedoMenu" Header="_Redo" InputGestureText="Ctrl+Y" Click="RedoClick"/>
        <Separator/>
        <MenuItem Header="Split at cursor" InputGestureText="S" Click="SplitClick"/>
        <MenuItem Header="Delete selection" InputGestureText="Delete" Click="DeleteClick"/>
        <MenuItem Header="Select all clips" InputGestureText="Ctrl+A" Click="SelectAllClick"/>
        <Separator/>
        <MenuItem Header="Link selected clips" InputGestureText="G" Click="LinkClick"/>
        <MenuItem Header="Unlink clip group" InputGestureText="U" Click="UnlinkClick"/>
        <MenuItem x:Name="IgnoreGroupsMenu" Header="Ignore clip groups" IsCheckable="True" Click="IgnoreGroupsClick"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Fit timeline" InputGestureText="Ctrl+F" Click="FitClick"/>
        <MenuItem Header="Zoom in" InputGestureText="+" Click="ZoomInClick"/>
        <MenuItem Header="Zoom out" InputGestureText="−" Click="ZoomOutClick"/>
        <MenuItem Header="Reset workspace" Click="ResetWorkspaceClick"/>
      </MenuItem>
      <MenuItem Header="_Insert"><MenuItem Header="Video track" InputGestureText="Ctrl+Shift+V" Click="VideoTrackClick"/><MenuItem Header="Audio track" InputGestureText="Ctrl+Shift+A" Click="AudioTrackClick"/></MenuItem>
      <MenuItem Header="_Options"><MenuItem x:Name="SnappingMenu" Header="Enable snapping" InputGestureText="N" IsCheckable="True" IsChecked="True" Click="SnapMenuClick"/><MenuItem x:Name="RippleMenu" Header="Ripple editing" IsCheckable="True" Click="RippleMenuClick"/></MenuItem>
      <MenuItem Header="_Help"><MenuItem Header="Keyboard shortcuts" Click="ShortcutsClick"/><MenuItem Header="About OpenRend" Click="AboutClick"/></MenuItem>
    </Menu>
    <Border Grid.Row="1" Background="#262626" Padding="3,1" BorderBrush="#111111" BorderThickness="0,0,0,2">
      <StackPanel Orientation="Horizontal">
        <Button Content="▯" ToolTip="New project (Ctrl+N)" Click="NewClick"/><Button Content="Open" ToolTip="Open project (Ctrl+O)" Click="OpenClick"/><Button Content="Save" ToolTip="Save project (Ctrl+S)" Click="SaveClick"/>
        <Button Content="Import media…" ToolTip="Import video or audio (Ctrl+I)" Click="ImportClick"/>
        <Separator Margin="5,0"/><Button x:Name="UndoButton" Content="↶" ToolTip="Undo (Ctrl+Z)" Click="UndoClick"/><Button x:Name="RedoButton" Content="↷" ToolTip="Redo (Ctrl+Y)" Click="RedoClick"/>
        <Button Content="Project settings" ToolTip="Project settings (Alt+Enter)" Click="SettingsClick"/><Button x:Name="RenderButton" Content="Render as…" ToolTip="Render edited timeline (Ctrl+Shift+E)" Click="ExportClick"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2" x:Name="Workspace" Margin="4,0">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="MediaWidth" Width=".32*" MinWidth="280"/><ColumnDefinition Width="5"/><ColumnDefinition Width=".68*" MinWidth="320"/><ColumnDefinition Width="5"/><ColumnDefinition Width="116"/></Grid.ColumnDefinitions>
      <TabControl x:Name="ToolsTabs" TabStripPlacement="Bottom">
        <TabItem Header="Project Media">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="#111111" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><Button Content="Import Media…" Click="ImportClick"/><Button Content="Add to timeline" Click="PlaceSelectedClick" ToolTip="Insert selected media at cursor"/></StackPanel></Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Background="#262626" Margin="6,8"><TextBlock Text="▾  All Media" FontWeight="SemiBold"/><TextBlock Text="    Video &amp; audio" Foreground="#B8B8B8" Margin="0,8"/><TextBlock Text="    Local files" Foreground="#B8B8B8"/><TextBlock x:Name="MediaCount" Foreground="#B8B8B8" Margin="0,18,0,0"/></StackPanel>
              <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"/>
              <Grid Grid.Column="2">
                <ListBox x:Name="MediaList" ItemsSource="{Binding Library}" MouseDoubleClick="MediaDoubleClick" PreviewMouseMove="MediaMouseMove" SelectionChanged="MediaSelectionChanged">
                  <ListBox.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#181818" Width="88" Height="50"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" FontSize="10" Foreground="#B8B8B8" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyLibrary" Text="Import video or audio&#10;Ctrl+I or drop files here" TextAlignment="Center" Foreground="#B8B8B8" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
            </Grid>
          </DockPanel>
        </TabItem>
        <TabItem Header="Explorer"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="Choose folder…" Click="BrowseFolderClick"/><TextBlock x:Name="FolderLabel" Text="Choose a folder to browse media" TextTrimming="CharacterEllipsis" MaxWidth="300" Margin="6,0"/></StackPanel><ListBox x:Name="ExplorerList" DisplayMemberPath="Name" MouseDoubleClick="ExplorerDoubleClick"/></DockPanel></TabItem>
        <TabItem Header="Clip Properties">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
            <TextBlock x:Name="ClipName" Text="Select a timeline clip" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Grid x:Name="Inspector" IsEnabled="False"><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Text="Position (frames)"/><TextBox x:Name="ClipStart" Grid.Column="1"/>
              <TextBlock Grid.Row="1" Text="Source in (frames)"/><TextBox x:Name="ClipIn" Grid.Row="1" Grid.Column="1"/>
              <TextBlock Grid.Row="2" Text="Duration (frames)"/><TextBox x:Name="ClipDuration" Grid.Row="2" Grid.Column="1"/>
              <TextBlock Grid.Row="3" Text="Opacity (0–1)"/><TextBox x:Name="ClipOpacity" Grid.Row="3" Grid.Column="1"/>
              <TextBlock Grid.Row="4" Text="Audio gain"/><TextBox x:Name="ClipGain" Grid.Row="4" Grid.Column="1"/>
              <TextBlock Grid.Row="5" Text="Pan (−1 to 1)"/><TextBox x:Name="ClipPan" Grid.Row="5" Grid.Column="1"/>
              <TextBlock Grid.Row="6" Text="Fade in (frames)"/><TextBox x:Name="ClipFadeIn" Grid.Row="6" Grid.Column="1"/>
              <TextBlock Grid.Row="7" Text="Fade out (frames)"/><TextBox x:Name="ClipFadeOut" Grid.Row="7" Grid.Column="1"/>
              <Button Grid.Row="8" Grid.Column="1" Content="Apply clip properties" Click="ApplyPropertiesClick" HorizontalAlignment="Left" Margin="2,10"/>
            </Grid>
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
      <TabControl Grid.Column="2" TabStripPlacement="Bottom"><TabItem Header="Video Preview">
        <Grid Background="#262626"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="4,2"><TextBlock Text="Video Preview" FontWeight="SemiBold" Margin="6,0"/><ComboBox x:Name="PreviewQuality" Width="135" HorizontalAlignment="Right" SelectionChanged="QualityChanged" SelectedIndex="1"><ComboBoxItem Content="Draft (320 × 180)"/><ComboBoxItem Content="Preview (640 × 360)"/><ComboBoxItem Content="Full project size"/></ComboBox></DockPanel>
          <Border Grid.Row="1" Background="Black"><local:PreviewHost x:Name="Preview"/></Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2"><Button Content="|◀" ToolTip="Go to start (Ctrl+Home)" Click="StartClick"/><Button Content="◀|" ToolTip="Previous frame (Alt+Left)" Click="PreviousClick"/><Button x:Name="PlayButton" Content="▶" ToolTip="Play / pause (Space)" Click="PlayClick"/><Button Content="Ⅱ" ToolTip="Pause (Enter)" Click="PauseClick"/><Button Content="■" ToolTip="Stop (Esc)" Click="StopClick"/><Button Content="|▶" ToolTip="Next frame (Alt+Right)" Click="NextClick"/></StackPanel>
          <TextBlock Grid.Row="3" x:Name="PreviewInfo" Margin="9,4" Foreground="#B8B8B8" FontSize="11"/>
        </Grid>
      </TabItem></TabControl>
      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>
      <DockPanel Grid.Column="4" Background="#262626">
        <TextBlock DockPanel.Dock="Bottom" Text="Master Bus" TextAlignment="Center" Margin="0,6"/>
        <TextBlock DockPanel.Dock="Top" Text="Master" FontWeight="SemiBold" Margin="9,10"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
          <Slider x:Name="MasterGain" Orientation="Vertical" Minimum="0" Maximum="2" Value="1" Margin="3,10" ToolTip="Monitor gain" ValueChanged="MasterGainChanged"/>
          <Border Grid.Column="1" Background="#181818" Margin="3,10"><Grid><Border x:Name="LeftMeter" VerticalAlignment="Bottom" Height="0" Background="#6DBA81"/></Grid></Border>
          <Border Grid.Column="2" Background="#181818" Margin="3,10"><Grid><Border x:Name="RightMeter" VerticalAlignment="Bottom" Height="0" Background="#6DBA81"/></Grid></Border>
          <TextBlock Grid.Column="3" Text="0&#10;&#10;−6&#10;&#10;−12&#10;&#10;−24&#10;&#10;−48" FontSize="9" Foreground="#B8B8B8" Margin="1,10"/>
        </Grid>
      </DockPanel>
    </Grid>
    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"/>
    <ui:TimelineView x:Name="Timeline" Grid.Row="4" Margin="4,0"/>
    <Border Grid.Row="5" Background="#262626" Padding="4" BorderBrush="#111111" BorderThickness="0,2,0,0"><DockPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="−" Click="ZoomOutClick" ToolTip="Zoom out"/><Slider x:Name="TimelineScroll" Width="150" Minimum="0" ValueChanged="TimelineScrollChanged" ToolTip="Timeline horizontal scroll"/><Button Content="+" Click="ZoomInClick" ToolTip="Zoom in"/><Button Content="Fit" Click="FitClick"/></StackPanel>
      <StackPanel Orientation="Horizontal"><TextBlock x:Name="Timecode" FontFamily="Consolas" FontSize="19" Width="244" Text="00:00:00:00" TextAlignment="Right" Margin="0,0,10,0"/><Button Content="|◀" Click="StartClick"/><Button Content="▶" Click="PlayClick" ToolTip="Play / pause (Space)"/><Button Content="Ⅱ" Click="PauseClick"/><Button Content="■" Click="StopClick"/><Button Content="▶|" Click="EndClick"/><Button Content="Split" Click="SplitClick" ToolTip="Split selected clips at cursor (S)"/><Button Content="Delete" Click="DeleteClick"/><CheckBox x:Name="SnapToggle" Content="Snap" IsChecked="True" Click="SnapClick"/><CheckBox x:Name="RippleToggle" Content="Ripple" Click="RippleClick"/></StackPanel>
    </DockPanel></Border>
    <DockPanel Grid.Row="6" Margin="8,3"><ProgressBar DockPanel.Dock="Right" Width="160" Maximum="1" Value="{Binding Progress}"/><Button x:Name="CancelRender" DockPanel.Dock="Right" Content="Cancel render" Visibility="Collapsed" Click="CancelExportClick" Padding="7,1"/><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Foreground="#B8B8B8" FontSize="11"/></DockPanel>
  </Grid>
</Window>
