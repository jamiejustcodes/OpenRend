<Window x:Class="OpenRend.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenRend.App"
        Title="Welcome" Width="830" Height="620" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" Background="#141414" KeyDown="WindowKeyDown">
  <Window.Resources>
    <Style x:Key="WelcomeTile" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#F0F0F0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Tile" Background="{TemplateBinding Background}" Margin="2" Padding="4"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="#398ED4"/></Trigger>
          <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="False"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Tile" Property="Background" Value="#3A3A3A"/></MultiTrigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#B9DFFF"/><Setter TargetName="Tile" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WelcomeNav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="2"/><Setter Property="Margin" Value="2"/><Setter Property="Height" Value="78"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
    </Style>
  </Window.Resources>
  <Border BorderBrush="#343434" BorderThickness="2" CornerRadius="4">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
      <Grid MouseLeftButtonDown="HeaderMouseDown">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Image Source="OpenRend.ico" Width="32" Height="32" Margin="0,0,5,0"/>
          <TextBlock Text="OpenRend" FontSize="22" FontWeight="SemiBold"/>
        </StackPanel>
        <Button Content="×" AutomationProperties.Name="Close welcome screen" AutomationProperties.AutomationId="CloseWelcome" HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" Height="32" Margin="0,0,6,0" Click="CloseClick" Style="{StaticResource CaptionButton}"/>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel>
          <Button x:Name="NewPageButton" Style="{StaticResource WelcomeNav}" AutomationProperties.AutomationId="NewProjectPageTabButton" Click="NewPageClick">
            <StackPanel><Path Data="M 3,0 L 20,0 28,8 28,32 3,32 Z M 20,0 L 20,8 28,8" Stroke="#EEE" Fill="#DDD" Width="28" Height="32" Stretch="Uniform" Margin="0,0,0,7"/><TextBlock Text="New Project" HorizontalAlignment="Center"/></StackPanel>
          </Button>
          <Button x:Name="OpenPageButton" Style="{StaticResource WelcomeNav}" AutomationProperties.AutomationId="OpenProjectPageTabButton" Click="OpenPageClick">
            <StackPanel><Path Data="M 0,5 L 12,5 16,9 32,9 32,29 0,29 Z" Fill="#EEE" Width="32" Height="32" Stretch="Uniform" Margin="0,0,0,7"/><TextBlock Text="Open Project" HorizontalAlignment="Center"/></StackPanel>
          </Button>
          <Button x:Name="HelpPageButton" Style="{StaticResource WelcomeNav}" AutomationProperties.AutomationId="GettingStartedPageTabButton" Click="HelpPageClick">
            <StackPanel><Path Data="M 0,10 L 18,0 36,10 18,20 Z M 7,16 L 7,25 Q 18,34 29,25 L 29,16 M 2,11 L 2,29" Fill="#EEE" Stroke="#EEE" Width="34" Height="32" Stretch="Uniform" Margin="0,0,0,7"/><TextBlock Text="Getting Started" HorizontalAlignment="Center"/></StackPanel>
          </Button>
        </StackPanel>
        <Grid Grid.Column="1" x:Name="NewPage" Background="#272727" Margin="2,0,2,0">
          <Grid.RowDefinitions><RowDefinition Height="312"/><RowDefinition Height="80"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <local:WelcomeArtwork x:Name="Artwork"/>
          <UniformGrid Grid.Row="1" Rows="1" x:Name="AspectTiles">
            <RadioButton GroupName="Aspect" x:Name="Widescreen" Tag="Widescreen" Style="{StaticResource WelcomeTile}" Checked="AspectChanged" AutomationProperties.Name="Widescreen (16:9)">
              <StackPanel><Path Data="M 0,0 L 28,0 28,18 0,18 Z M 7,22 L 21,22 M 14,18 L 14,22" Stroke="#EEE" StrokeThickness="1.7" Width="28" Height="27" Stretch="Uniform" Margin="0,0,0,7"/><TextBlock Text="Widescreen (16:9)"/></StackPanel>
            </RadioButton>
            <RadioButton GroupName="Aspect" x:Name="Fullscreen" Tag="Fullscreen" Style="{StaticResource WelcomeTile}" Checked="AspectChanged" AutomationProperties.Name="Fullscreen (4:3)">
              <StackPanel><Rectangle Stroke="#EEE" StrokeThickness="1.7" Width="26" Height="22" Margin="0,0,0,10"/><TextBlock Text="Fullscreen (4:3)"/></StackPanel>
            </RadioButton>
            <RadioButton GroupName="Aspect" x:Name="Portrait" Tag="Portrait" Style="{StaticResource WelcomeTile}" Checked="AspectChanged" AutomationProperties.Name="Portrait (9:16)">
              <StackPanel><Border BorderBrush="#EEE" BorderThickness="1.7" CornerRadius="4" Width="17" Height="29" Margin="0,0,0,3"><Ellipse Width="3" Height="3" Fill="#EEE" VerticalAlignment="Bottom" Margin="0,0,0,3"/></Border><TextBlock Text="Portrait (9:16)"/></StackPanel>
            </RadioButton>
            <RadioButton GroupName="Aspect" x:Name="Square" Tag="Square" Style="{StaticResource WelcomeTile}" Checked="AspectChanged" AutomationProperties.Name="Square (1:1)">
              <StackPanel><Path Data="M 4,0 L 22,0 Q 26,0 26,4 L 26,18 Q 26,22 22,22 L 12,22 5,29 5,22 4,22 Q 0,22 0,18 L 0,4 Q 0,0 4,0" Stroke="#EEE" StrokeThickness="1.7" Width="26" Height="29" Stretch="Uniform" Margin="0,0,0,3"/><TextBlock Text="Square (1:1)"/></StackPanel>
            </RadioButton>
            <RadioButton GroupName="Aspect" x:Name="Scope" Tag="Scope" Style="{StaticResource WelcomeTile}" Checked="AspectChanged" AutomationProperties.Name="Scope (2.4:1)">
              <StackPanel><Path Data="M 0,0 L 28,0 28,15 0,15 Z M 3,19 L 25,19 29,25 -1,25 Z" Stroke="#EEE" StrokeThickness="1.7" Width="30" Height="27" Stretch="Uniform" Margin="0,0,0,5"/><TextBlock Text="Scope (2.4:1)"/></StackPanel>
            </RadioButton>
          </UniformGrid>
          <Grid Grid.Row="2" Margin="10,8,5,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="194"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="27"/><RowDefinition Height="27"/><RowDefinition Height="27"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Create a new project" FontWeight="Bold" Grid.ColumnSpan="3"/>
            <Label Grid.Row="1" Content="Resolution:" Target="Resolution" Foreground="#EEE" Padding="0"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="Resolution" AutomationProperties.AutomationId="Resolution" AutomationProperties.Name="Resolution" SelectionChanged="ResolutionChanged"/>
            <Label Grid.Row="2" Content="Framerate:" Target="FrameRate" Foreground="#EEE" Padding="0"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FrameRate" AutomationProperties.AutomationId="FrameRate" AutomationProperties.Name="Framerate" SelectionChanged="FrameRateChanged"/>
            <ComboBox Grid.Row="2" Grid.Column="2" x:Name="FrameRateType" AutomationProperties.AutomationId="FrameRateType" AutomationProperties.Name="Frame rate type" SelectionChanged="FrameRateTypeChanged"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
              <Button Content="Create Project" MinWidth="128" Padding="4,1" IsDefault="True" AutomationProperties.AutomationId="CreateProject" Click="CreateClick"/>
              <Button Content="Advanced Settings..." MinWidth="128" Padding="4,1" AutomationProperties.AutomationId="AdvancedSettings" Click="AdvancedClick"/>
            </StackPanel>
            <TextBlock Grid.Row="4" Grid.ColumnSpan="3" x:Name="Error" Foreground="#FFB4AB" TextWrapping="Wrap"/>
          </Grid>
        </Grid>
        <Grid Grid.Column="1" x:Name="OpenPage" Visibility="Collapsed" Background="#272727" Margin="2,0,2,0">
          <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
          <TextBlock Text="Open a project" FontSize="20" Margin="20,0"/>
          <ListBox Grid.Row="1" x:Name="RecentProjects" AutomationProperties.AutomationId="RecentProjects" AutomationProperties.Name="Recent projects" Margin="20,0" MouseDoubleClick="RecentDoubleClick">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6"><TextBlock Text="{Binding Name}" FontSize="13"/><TextBlock Text="{Binding Path}" Foreground="#B7B7B7" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1" x:Name="NoRecentProjects" Text="No recent projects. Browse to open an OpenRend project." VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,6">
            <Button Content="Browse..." AutomationProperties.AutomationId="BrowseProject" Click="BrowseProjectClick" MinWidth="100"/>
            <Button Content="Open Project" AutomationProperties.AutomationId="OpenRecentProject" Click="OpenRecentClick" MinWidth="100"/>
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Column="1" x:Name="HelpPage" Visibility="Collapsed" Background="#272727" Margin="2,0,2,0" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26">
            <TextBlock Text="Getting Started" FontSize="24" Margin="0,0,0,24"/>
            <TextBlock Text="Create your project" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Choose an aspect ratio, resolution and frame rate. Create Project opens an empty timeline with those settings." TextWrapping="Wrap" Margin="0,8,0,24"/>
            <TextBlock Text="Add and edit media" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Use Ctrl+I to import media. Double-click a source or drag it onto the timeline. Drag event edges to trim, S to split and Ctrl+Z to undo." TextWrapping="Wrap" Margin="0,8,0,24"/>
            <TextBlock Text="Preview and render" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Space plays or pauses. Ctrl+S saves your edit decisions. Ctrl+Shift+E opens Render As. Source media stays unchanged." TextWrapping="Wrap" Margin="0,8,0,24"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <CheckBox Grid.Row="2" x:Name="ShowAtStartup" Content="Show Welcome Screen on Startup" AutomationProperties.AutomationId="ShowAtStartup" Margin="10,2" VerticalAlignment="Center" Checked="StartupChanged" Unchecked="StartupChanged"/>
    </Grid>
  </Border>
</Window>
