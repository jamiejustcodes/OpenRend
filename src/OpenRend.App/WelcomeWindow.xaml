<Window x:Class="OpenRend.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenRend.App"
        Title="Welcome" Width="830" Height="620" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" Background="{StaticResource ColorBG}" KeyDown="WindowKeyDown">
  <Window.Resources>
    <Style x:Key="WelcomeTile" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
      <Setter Property="Background" Value="{StaticResource ColorD}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Tile" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" Padding="6,8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="{StaticResource ActiveColor}"/>
                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource ActiveColorHover}"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="False"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Tile" Property="Background" Value="{StaticResource HoverColor}"/>
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WelcomeNav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="2"/><Setter Property="Height" Value="78"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
    </Style>
  </Window.Resources>
  <Border BorderBrush="{StaticResource ColorD}" BorderThickness="2" CornerRadius="4">
    <Border.Effect>
      <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
      <Grid MouseLeftButtonDown="HeaderMouseDown" Background="{StaticResource ColorBG}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Source="OpenRend.ico" Width="28" Height="28" Margin="0,0,8,0"/>
          <TextBlock Text="OpenRend" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextColor}"/>
        </StackPanel>
        <Button Content="×" AutomationProperties.Name="Close welcome screen" AutomationProperties.AutomationId="CloseWelcome" HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" Height="32" Margin="0,0,6,0" Click="CloseClick" Style="{StaticResource CaptionButton}"/>
      </Grid>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="106"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Background="{StaticResource ColorBG}">
          <Button x:Name="NewPageButton" Style="{StaticResource WelcomeNav}" AutomationProperties.AutomationId="NewProjectPageTabButton" Click="NewPageClick">
            <StackPanel>
              <ContentControl ContentTemplate="{StaticResource ic_file}" Width="24" Height="24" Style="{StaticResource BaseContentControl}" Margin="0,0,0,6"/>
              <TextBlock Text="New Project" HorizontalAlignment="Center" Foreground="{StaticResource TextColor}"/>
            </StackPanel>
          </Button>
          <Button x:Name="OpenPageButton" Style="{StaticResource WelcomeNav}" AutomationProperties.AutomationId="OpenProjectPageTabButton" Click="OpenPageClick">
            <StackPanel>
              <ContentControl ContentTemplate="{StaticResource ic_open}" Width="24" Height="24" Style="{StaticResource BaseContentControl}" Margin="0,0,0,6"/>
              <TextBlock Text="Open Project" HorizontalAlignment="Center" Foreground="{StaticResource TextColor}"/>
            </StackPanel>
          </Button>
          <Button x:Name="HelpPageButton" Style="{StaticResource WelcomeNav}" AutomationProperties.AutomationId="GettingStartedPageTabButton" Click="HelpPageClick">
            <StackPanel>
              <ContentControl ContentTemplate="{StaticResource ic_help}" Width="24" Height="24" Style="{StaticResource BaseContentControl}" Margin="0,0,0,6"/>
              <TextBlock Text="Getting Started" HorizontalAlignment="Center" Foreground="{StaticResource TextColor}"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <Grid Grid.Column="1" x:Name="NewPage" Background="{StaticResource ColorD}" Margin="2,0,2,0">
          <Grid.RowDefinitions><RowDefinition Height="312"/><RowDefinition Height="84"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <local:WelcomeArtwork x:Name="Artwork"/>
          <UniformGrid Grid.Row="1" Rows="1" x:Name="AspectTiles" Margin="4,0">
            <RadioButton GroupName="Aspect" x:Name="Widescreen" Tag="Widescreen" Style="{StaticResource WelcomeTile}" Checked="AspectChanged" AutomationProperties.Name="Widescreen (16:9)">
              <StackPanel>
                <ContentControl ContentTemplate="{StaticResource ic_welcome_widescreen}" Width="32" Height="32" Style="{StaticResource BaseContentControl}" Margin="0,0,0,4"/>
                <TextBlock Text="Widescreen (16:9)" FontSize="10" TextAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton GroupName="Aspect" x:Name="Fullscreen" Tag="Fullscreen" Style="{StaticResource WelcomeTile}" Checked="AspectChanged" AutomationProperties.Name="Fullscreen (4:3)">
              <StackPanel>
                <ContentControl ContentTemplate="{StaticResource ic_welcome_fullscreen}" Width="32" Height="32" Style="{StaticResource BaseContentControl}" Margin="0,0,0,4"/>
                <TextBlock Text="Fullscreen (4:3)" FontSize="10" TextAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton GroupName="Aspect" x:Name="Portrait" Tag="Portrait" Style="{StaticResource WelcomeTile}" Checked="AspectChanged" AutomationProperties.Name="Portrait (9:16)">
              <StackPanel>
                <ContentControl ContentTemplate="{StaticResource ic_welcome_portrait}" Width="32" Height="32" Style="{StaticResource BaseContentControl}" Margin="0,0,0,4"/>
                <TextBlock Text="Portrait (9:16)" FontSize="10" TextAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton GroupName="Aspect" x:Name="Square" Tag="Square" Style="{StaticResource WelcomeTile}" Checked="AspectChanged" AutomationProperties.Name="Square (1:1)">
              <StackPanel>
                <ContentControl ContentTemplate="{StaticResource ic_welcome_square}" Width="32" Height="32" Style="{StaticResource BaseContentControl}" Margin="0,0,0,4"/>
                <TextBlock Text="Square (1:1)" FontSize="10" TextAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton GroupName="Aspect" x:Name="Scope" Tag="Scope" Style="{StaticResource WelcomeTile}" Checked="AspectChanged" AutomationProperties.Name="Scope (2.4:1)">
              <StackPanel>
                <ContentControl ContentTemplate="{StaticResource ic_welcome_scope}" Width="32" Height="32" Style="{StaticResource BaseContentControl}" Margin="0,0,0,4"/>
                <TextBlock Text="Scope (2.4:1)" FontSize="10" TextAlignment="Center"/>
              </StackPanel>
            </RadioButton>
          </UniformGrid>
          <Grid Grid.Row="2" Margin="14,10,14,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="194"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="28"/><RowDefinition Height="28"/><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="Create a new project" FontWeight="Bold" Foreground="{StaticResource TextColor}" Grid.ColumnSpan="3"/>
            <Label Grid.Row="1" Content="Resolution:" Target="Resolution" Foreground="{StaticResource TextColor}" Padding="0" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="Resolution" AutomationProperties.AutomationId="Resolution" AutomationProperties.Name="Resolution" SelectionChanged="ResolutionChanged" VerticalAlignment="Center"/>
            <Label Grid.Row="2" Content="Framerate:" Target="FrameRate" Foreground="{StaticResource TextColor}" Padding="0" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="FrameRate" AutomationProperties.AutomationId="FrameRate" AutomationProperties.Name="Framerate" SelectionChanged="FrameRateChanged" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="2" x:Name="FrameRateType" AutomationProperties.AutomationId="FrameRateType" AutomationProperties.Name="Frame rate type" SelectionChanged="FrameRateTypeChanged" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Create Project" Style="{StaticResource TextButton}" MinWidth="130" Height="26" Margin="0,0,8,0" IsDefault="True" AutomationProperties.AutomationId="CreateProject" Click="CreateClick"/>
              <Button Content="Advanced Settings..." Style="{StaticResource TextButton}" MinWidth="130" Height="26" AutomationProperties.AutomationId="AdvancedSettings" Click="AdvancedClick"/>
            </StackPanel>
            <TextBlock Grid.Row="4" Grid.ColumnSpan="3" x:Name="Error" Foreground="{StaticResource IconRed}" TextWrapping="Wrap"/>
          </Grid>
        </Grid>
        <Grid Grid.Column="1" x:Name="OpenPage" Visibility="Collapsed" Background="{StaticResource ColorD}" Margin="2,0,2,0">
          <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
          <TextBlock Text="Open a project" FontSize="20" Foreground="{StaticResource TextColor}" Margin="20,16"/>
          <ListBox Grid.Row="1" x:Name="RecentProjects" AutomationProperties.AutomationId="RecentProjects" AutomationProperties.Name="Recent projects" Margin="20,0" MouseDoubleClick="RecentDoubleClick">
            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,6"><TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextColor}"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource TextColorGrey}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="1" x:Name="NoRecentProjects" Text="No recent projects. Browse to open an OpenRend project." Foreground="{StaticResource TextColorGrey}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,6">
            <Button Content="Browse..." Style="{StaticResource TextButton}" AutomationProperties.AutomationId="BrowseProject" Click="BrowseProjectClick" MinWidth="100" Margin="0,0,8,0"/>
            <Button Content="Open Project" Style="{StaticResource TextButton}" AutomationProperties.AutomationId="OpenRecentProject" Click="OpenRecentClick" MinWidth="100"/>
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Column="1" x:Name="HelpPage" Visibility="Collapsed" Background="{StaticResource ColorD}" Margin="2,0,2,0" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="26">
            <TextBlock Text="Getting Started" FontSize="24" Foreground="{StaticResource TextColor}" Margin="0,0,0,24"/>
            <TextBlock Text="Create your project" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextColor}"/>
            <TextBlock Text="Choose an aspect ratio, resolution and frame rate. Create Project opens an empty timeline with those settings." Foreground="{StaticResource TextColor}" TextWrapping="Wrap" Margin="0,8,0,24"/>
            <TextBlock Text="Add and edit media" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextColor}"/>
            <TextBlock Text="Use Ctrl+I to import media. Double-click a source or drag it onto the timeline. Drag event edges to trim, S to split and Ctrl+Z to undo." Foreground="{StaticResource TextColor}" TextWrapping="Wrap" Margin="0,8,0,24"/>
            <TextBlock Text="Preview and render" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextColor}"/>
            <TextBlock Text="Space plays or pauses. Ctrl+S saves your edit decisions. Ctrl+Shift+E opens Render As. Source media stays unchanged." Foreground="{StaticResource TextColor}" TextWrapping="Wrap" Margin="0,8,0,24"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <CheckBox Grid.Row="2" x:Name="ShowAtStartup" Content="Show Welcome Screen on Startup" AutomationProperties.AutomationId="ShowAtStartup" Margin="10,2" VerticalAlignment="Center" Checked="StartupChanged" Unchecked="StartupChanged"/>
    </Grid>
  </Border>
</Window>
