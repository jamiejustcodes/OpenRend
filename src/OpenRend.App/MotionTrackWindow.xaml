<Window x:Class="OpenRend.App.MotionTrackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Motion Tracker - OpenRend"
        Width="450" Height="800"
        MinWidth="380" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ColorBG}"
        Foreground="{DynamicResource TextColor}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="KeyDownPress" Unloaded="MotionTrackWindow_Unloaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Icons.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>

  <Grid Name="gMain" Background="{DynamicResource ColorBG}" Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="30" />
      <RowDefinition Height="1" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Top Header Bar (Height=30) matching Vegas Pro Motion Tracker -->
    <Grid Background="{DynamicResource ColorD}" Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="30" />
      </Grid.ColumnDefinitions>
      <TextBlock Name="tbGuiName" Text="Motion tracker" Foreground="{DynamicResource TextColor}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
      <Button Name="bRefresh" Template="{DynamicResource RefreshButton}" Grid.Column="1" Margin="3" Click="RefreshClick" ToolTip="Refresh tracking regions" />
      <Grid Background="{DynamicResource ColorBG}" Height="1" VerticalAlignment="Bottom" Grid.ColumnSpan="2" />
    </Grid>

    <Grid Background="{DynamicResource ColorBG}" Height="1" Grid.Row="1" />

    <!-- Body ScrollViewer -->
    <ScrollViewer Name="outerStack" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Grid.Row="2" Background="{DynamicResource ColorD}">
      <StackPanel Orientation="Vertical" Margin="8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition MinHeight="24" />
            <RowDefinition MinHeight="24" />
            <RowDefinition MinHeight="24" />
            <RowDefinition MinHeight="24" />
            <RowDefinition MinHeight="24" />
            <RowDefinition MinHeight="24" />
            <RowDefinition MinHeight="8" />
            <RowDefinition MinHeight="24" />
            <RowDefinition MinHeight="20" />
            <RowDefinition MinHeight="24" />
            <RowDefinition MinHeight="36" />
          </Grid.RowDefinitions>

          <!-- Row 0: Clip Name -->
          <TextBlock Name="lClipName" Text="lClipName" Grid.ColumnSpan="3" Foreground="{DynamicResource TextColor}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,0,4" />

          <!-- Row 1: Mask selector row -->
          <TextBlock Foreground="{DynamicResource TextColor}" Text="Mask:" VerticalAlignment="Center" Grid.Row="1" />
          <Grid Grid.Column="2" Grid.Row="1" Margin="0,4" Height="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Name="cbMasks" DisplayMemberPath="Name" Foreground="{DynamicResource TextColor}" SelectionChanged="MaskSelectionChanged" />
            <Button Name="bAdd" Template="{DynamicResource AddMaskButton}" Grid.Column="1" Width="24" Height="24" Margin="4,0,0,0" ToolTipService.ShowOnDisabled="True" Click="AddMask">
              <FrameworkElement.ToolTip>
                <StackPanel Orientation="Vertical" Width="160">
                  <TextBlock Name="bAddTipHeader" Text="Add Tracking Region" FontWeight="Bold" />
                  <TextBlock Name="bAddTipText" Text="Adds a motion tracking region to track objects in the video clip." FontWeight="Normal" TextWrapping="Wrap" />
                </StackPanel>
              </FrameworkElement.ToolTip>
            </Button>
            <Button Name="bRemove" Template="{DynamicResource DeleteMaskButton}" Grid.Column="2" Width="24" Height="24" Margin="4,0,0,0" ToolTipService.ShowOnDisabled="True" Click="RemoveMask">
              <FrameworkElement.ToolTip>
                <StackPanel Orientation="Vertical" Width="160">
                  <TextBlock Name="bRemoveTipHeader" Text="Remove Tracking Region" FontWeight="Bold" />
                  <TextBlock Name="bRemoveTipText" Text="Removes the selected motion tracking region." FontWeight="Normal" TextWrapping="Wrap" />
                </StackPanel>
              </FrameworkElement.ToolTip>
            </Button>
            <Menu Width="24" Height="24" Grid.Column="3" Margin="4,0,0,0" Background="Transparent">
              <MenuItem Name="bAddMenu" Template="{DynamicResource MenuItemButton}" Foreground="{DynamicResource TextColor}" Margin="0" Visibility="Collapsed" />
            </Menu>
          </Grid>

          <!-- Row 2: Invert Mask -->
          <CheckBox Name="chkMaskInvert" Content="Invert mask" Grid.Row="2" Grid.Column="2" Checked="ToggleMaskInvert" Unchecked="ToggleMaskInvert" VerticalAlignment="Center" Margin="0,4,0,8" />

          <!-- Row 3: Precision -->
          <TextBlock Name="lOptionPrecision" Text="Precision:" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" Grid.Row="3" />
          <ComboBox Name="cbPrecision" Foreground="{DynamicResource TextColor}" Grid.Row="3" Height="24" Margin="0,4" Grid.Column="2" SelectionChanged="PrecisionChanged" />

          <!-- Row 4: Mode -->
          <TextBlock Name="lOptionMode" Text="Mode:" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" Grid.Row="4" />
          <ComboBox Name="cbMode" Foreground="{DynamicResource TextColor}" Grid.Row="4" Height="24" Margin="0,4,0,8" Grid.Column="2" SelectionChanged="ModeChanged" />

          <!-- Row 5: Show Motion Vectors -->
          <CheckBox Name="chkShowFeatures" Content="Show motion vectors" Grid.Row="5" Grid.Column="2" Checked="ShowMotionVectors" Unchecked="ShowMotionVectors" VerticalAlignment="Center" Margin="0,4,0,8" />

          <!-- Row 7: Progressbar Header -->
          <TextBlock Name="tbProgressbar" Text="Motion tracked:" Grid.ColumnSpan="3" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" Grid.Row="7" />

          <!-- Row 8: 100-segment Progress Bar Grid -->
          <Border Grid.Row="8" Grid.ColumnSpan="3" Background="{DynamicResource ColorBG}" BorderBrush="{DynamicResource ColorEdge}" BorderThickness="1" Height="14" VerticalAlignment="Center">
            <Grid Name="gProgress" MouseUp="seekOnProgressBar" MouseEnter="mouseCursor2Pointer" MouseLeave="mouseNormalCursor" Background="Transparent" />
          </Border>

          <!-- Row 9: Status Text -->
          <TextBlock Name="sbStatusText" Text="" Grid.Row="9" Grid.ColumnSpan="3" Foreground="{DynamicResource TextColorGrey}" VerticalAlignment="Center" Margin="0,4" TextTrimming="CharacterEllipsis" />

          <!-- Row 10: Transport & Transfer Toolbar -->
          <StackPanel Grid.Row="10" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Name="bBackTrack" Template="{DynamicResource ToStartButton}" Width="24" Height="24" Margin="2,0" ToolTipService.ShowOnDisabled="True" Click="TrackBackward">
              <FrameworkElement.ToolTip>
                <StackPanel Orientation="Vertical" Width="160">
                  <TextBlock Name="bBackTrackTipHeader" Text="Track to Event Start" FontWeight="Bold" />
                  <TextBlock Name="bBackTrackTipText" Text="Tracks backward from cursor to the start of the event." FontWeight="Normal" TextWrapping="Wrap" />
                </StackPanel>
              </FrameworkElement.ToolTip>
            </Button>
            <Button Name="bBackOne" Template="{DynamicResource PrevFrameButton}" Width="24" Height="24" Margin="2,0" ToolTipService.ShowOnDisabled="True" Click="TrackPreviousFrame">
              <FrameworkElement.ToolTip>
                <StackPanel Orientation="Vertical" Width="160">
                  <TextBlock Name="bBackOneTipHeader" Text="Track One Frame Backward" FontWeight="Bold" />
                  <TextBlock Name="bBackOneTipText" Text="Tracks backward one frame from current cursor position." FontWeight="Normal" TextWrapping="Wrap" />
                </StackPanel>
              </FrameworkElement.ToolTip>
            </Button>
            <Button Name="bTrackAll" Template="{DynamicResource ToFullButton}" Width="24" Height="24" Margin="2,0" ToolTipService.ShowOnDisabled="True" Click="TrackAll">
              <FrameworkElement.ToolTip>
                <StackPanel Orientation="Vertical" Width="160">
                  <TextBlock Name="bTrackAllTipHeader" Text="Track Full Range" FontWeight="Bold" />
                  <TextBlock Name="bTrackAllTipText" Text="Tracks throughout the entire event in both directions." FontWeight="Normal" TextWrapping="Wrap" />
                </StackPanel>
              </FrameworkElement.ToolTip>
            </Button>
            <Button Name="bForwardOne" Template="{DynamicResource NextFrameButton}" Width="24" Height="24" Margin="2,0" ToolTipService.ShowOnDisabled="True" Click="TrackNextFrame">
              <FrameworkElement.ToolTip>
                <StackPanel Orientation="Vertical" Width="160">
                  <TextBlock Name="bForwardOneTipHeader" Text="Track One Frame Forward" FontWeight="Bold" />
                  <TextBlock Name="bForwardOneTipText" Text="Tracks forward one frame from current cursor position." FontWeight="Normal" TextWrapping="Wrap" />
                </StackPanel>
              </FrameworkElement.ToolTip>
            </Button>
            <Button Name="bForTrack" Template="{DynamicResource ToEndButton}" Width="24" Height="24" Margin="2,0" ToolTipService.ShowOnDisabled="True" Click="TrackForward">
              <FrameworkElement.ToolTip>
                <StackPanel Orientation="Vertical" Width="160">
                  <TextBlock Name="bForTrackTipHeader" Text="Track to Event End" FontWeight="Bold" />
                  <TextBlock Name="bForTrackTipText" Text="Tracks forward from cursor to the end of the event." FontWeight="Normal" TextWrapping="Wrap" />
                </StackPanel>
              </FrameworkElement.ToolTip>
            </Button>
            <Button Name="bAttachDrag" Template="{DynamicResource TransferTrackIcon}" Width="24" Height="24" Margin="4,0,2,0" ToolTipService.ShowOnDisabled="True" PreviewMouseDown="bAttach_DropCursor">
              <FrameworkElement.ToolTip>
                <StackPanel Orientation="Vertical" Width="160">
                  <TextBlock Name="bAttachDragTipHeader" Text="Drag Motion Track" FontWeight="Bold" />
                  <TextBlock Name="bAttachDragTipText" Text="Drag and drop motion data to another clip or track." FontWeight="Normal" TextWrapping="Wrap" />
                </StackPanel>
              </FrameworkElement.ToolTip>
            </Button>
            <Menu Name="bAttachMenu" Width="24" Height="24" Margin="2,0" Background="Transparent">
              <MenuItem Name="bAttach" Template="{DynamicResource MenuItemButton}" Foreground="{DynamicResource TextColor}" Margin="0" ToolTipService.ShowOnDisabled="True" MouseEnter="bAttach_PreviewMouseDown">
                <FrameworkElement.ToolTip>
                  <StackPanel Orientation="Vertical" Width="160">
                    <TextBlock Name="bAttachTipHeader" Text="Transfer Motion Track" FontWeight="Bold" />
                    <TextBlock Name="bAttachTipText" Text="Select target clip and effect to transfer motion track." FontWeight="Normal" TextWrapping="Wrap" />
                  </StackPanel>
                </FrameworkElement.ToolTip>
              </MenuItem>
            </Menu>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
