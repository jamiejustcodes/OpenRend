      <!-- Vegas Pro Authentic Scrollbar with Thumb Dual Grip Lines & Arrow Buttons -->
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="16"/><Setter Property="Background" Value="{StaticResource ScrollbarBackgroundColor}"/><Setter Property="Foreground" Value="{StaticResource ScrollbarColor}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
          <Grid Background="{StaticResource ScrollbarBackgroundColor}">
            <Grid.RowDefinitions>
              <RowDefinition Height="16" />
              <RowDefinition Height="*" />
              <RowDefinition Height="16" />
            </Grid.RowDefinitions>
            <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Style="{StaticResource TrackRepeatButton}" Height="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
              <ContentControl ContentTemplate="{StaticResource ic_up}" Width="16" Height="16" Style="{StaticResource BaseContentControl}" />
            </RepeatButton>
            <Track x:Name="PART_Track" Grid.Row="1" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
              <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Style="{StaticResource TrackRepeatButton}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="ScrollThumb" MinHeight="18" Background="{StaticResource ScrollbarColor}">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid x:Name="Surface" Background="{TemplateBinding Background}">
                        <!-- Vegas Pro dual 1px grip lines centered on vertical thumb -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Height="4" Width="8" IsHitTestVisible="False">
                          <Border Height="1" VerticalAlignment="Top" Background="{StaticResource ScrollbarBackgroundColor}" />
                          <Border Height="1" VerticalAlignment="Bottom" Background="{StaticResource ScrollbarBackgroundColor}" />
                        </Grid>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ScrollbarHoverColor}"/></Trigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ScrollbarHoverColor}"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Style="{StaticResource TrackRepeatButton}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Row="2" Command="{x:Static ScrollBar.LineDownCommand}" Style="{StaticResource TrackRepeatButton}" Height="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
              <ContentControl ContentTemplate="{StaticResource ic_down}" Width="16" Height="16" Style="{StaticResource BaseContentControl}" />
            </RepeatButton>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="16"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="16"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                  <Grid Background="{StaticResource ScrollbarBackgroundColor}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="16" />
                    </Grid.ColumnDefinitions>
                    <RepeatButton Command="{x:Static ScrollBar.LineLeftCommand}" Style="{StaticResource TrackRepeatButton}" Width="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                      <ContentControl ContentTemplate="{StaticResource ic_left}" Width="16" Height="16" Style="{StaticResource BaseContentControl}" />
                    </RepeatButton>
                    <Track x:Name="PART_Track" Grid.Column="1" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="False" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                      <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource TrackRepeatButton}" Command="{x:Static ScrollBar.PageLeftCommand}"/></Track.DecreaseRepeatButton>
                      <Track.Thumb>
                        <Thumb MinWidth="18" Background="{StaticResource ScrollbarColor}">
                          <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                              <Grid x:Name="Surface" Background="{TemplateBinding Background}">
                                <!-- Vegas Pro dual 1px grip lines centered on horizontal thumb -->
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="4" Height="8" IsHitTestVisible="False">
                                  <Border Width="1" HorizontalAlignment="Left" Background="{StaticResource ScrollbarBackgroundColor}" />
                                  <Border Width="1" HorizontalAlignment="Right" Background="{StaticResource ScrollbarBackgroundColor}" />
                                </Grid>
                              </Grid>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ScrollbarHoverColor}"/></Trigger>
                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ScrollbarHoverColor}"/></Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Thumb.Template>
                        </Thumb>
                      </Track.Thumb>
                      <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource TrackRepeatButton}" Command="{x:Static ScrollBar.PageRightCommand}"/></Track.IncreaseRepeatButton>
                    </Track>
                    <RepeatButton Grid.Column="2" Command="{x:Static ScrollBar.LineRightCommand}" Style="{StaticResource TrackRepeatButton}" Width="16" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                      <ContentControl ContentTemplate="{StaticResource ic_right}" Width="16" Height="16" Style="{StaticResource BaseContentControl}" />
                    </RepeatButton>
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>

