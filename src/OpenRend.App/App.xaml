          </Grid>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="NumericSpinButton" TargetType="RepeatButton">
        <Setter Property="Foreground" Value="{StaticResource TextColor}"/><Setter Property="Background" Value="{StaticResource ColorM}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverColor}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource ActiveColor}"/></Trigger></ControlTemplate.Triggers>
